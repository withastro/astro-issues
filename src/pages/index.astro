---
import LabelStats from "../components/LabelStats.astro";
import Layout from "../layouts/Layout.astro";
import { filteredRepos, getAverageCountForRepo, getTimeSeriesForRepo } from "../scripts/data";
import { statsFromLast30Days } from "issues:stats";

const calculateDrops = (metric: 'issueCount' | 'pullRequestCount') => (repo: string) => {
	const stats = getTimeSeriesForRepo(repo, metric);
	const highestPeak = Math.max(...stats.map((stat) => stat));
	const current = stats[stats.length - 1];

	return {
		repo,
		current,
		peakDate: Object.keys(statsFromLast30Days)[stats.indexOf(highestPeak)],
		peak: highestPeak,
		drop: highestPeak - current,
	};
};

const biggestIssuesDropFromPeak = filteredRepos
	.map(calculateDrops('issueCount'))
	.sort((a, b) => b.drop - a.drop);

const biggestPRsDropFromPeak = filteredRepos
	.map(calculateDrops('pullRequestCount'))
	.sort((a, b) => b.drop - a.drop);

function getStandardDeviation(array: number[]) {
	const n = array.length;
	const mean = array.reduce((a, b) => a + b) / n;
	return Math.sqrt(array.map((x) => Math.pow(x - mean, 2)).reduce((a, b) => a + b) / n);
}

const getRepoWithLeastStandardDeviation = (metric: 'issueCount' | 'pullRequestCount') => {
	const standardDeviationPerRepo = filteredRepos
		.filter((repo) => getAverageCountForRepo(repo, metric) > 7)
		.map((repo) => {
			const stats = getTimeSeriesForRepo(repo, metric);
			const standardDeviation = getStandardDeviation(stats);
			return { repo, standardDeviation };
		})
		.sort((a, b) => b.standardDeviation - a.standardDeviation);

	return standardDeviationPerRepo[standardDeviationPerRepo.length - 1];
};

const repoWithLeastIssueCountSD = getRepoWithLeastStandardDeviation('issueCount');
const repoWithLeastPRCountSD = getRepoWithLeastStandardDeviation('pullRequestCount');

const funStats = [
	{
		prompt: `Repo with biggest drop in issues <abbr
      class="text-gray-800 heading-5 ml-[-5px] align-top"
      title="From their highest peak in the last 30 days to today"
      >(?)</abbr
    >`,
		repo: biggestIssuesDropFromPeak[0].repo,
		comment: `Went from ${biggestIssuesDropFromPeak[0].peak} issues on the ${biggestIssuesDropFromPeak[0].peakDate} to ${biggestIssuesDropFromPeak[0].current} issues today.`,
	},
	{
		prompt: `Repo with the least change in issues count`,
		repo: repoWithLeastIssueCountSD.repo,
		comment: `Average issue count of ${Math.floor(
			getAverageCountForRepo(repoWithLeastIssueCountSD.repo, 'issueCount'),
		)} (σ = ${repoWithLeastIssueCountSD.standardDeviation.toFixed(2)}) in the last 30 days.`,
	},
	{
		prompt: `Repo with biggest drop in open PRs <abbr
	    class="text-gray-800 heading-5 ml-[-5px] align-top"
	    title="From their highest peak in the last 30 days to today"
	    >(?)</abbr
	  >`,
		repo: biggestPRsDropFromPeak[0].repo,
		comment: `Went from ${biggestPRsDropFromPeak[0].peak} open PRs on the ${biggestPRsDropFromPeak[0].peakDate} to ${biggestPRsDropFromPeak[0].current} open PRs today.`,
	},
	{
		prompt: `Repo with the least change in open PRs count`,
		repo: repoWithLeastPRCountSD.repo,
		comment: `Average open PR count of ${Math.floor(
			getAverageCountForRepo(repoWithLeastPRCountSD.repo, 'pullRequestCount'),
		)} (σ = ${repoWithLeastPRCountSD.standardDeviation.toFixed(2)}) in the last 30 days.`,
	},
];
---

<Layout wide>
  <h2 class="heading-3 text-white mb-6">Last 30 days</h2>
  <div class="flex flex-col gap-8 md:grid md:grid-cols-2">
    <div>
      <h3 class="heading-4 text-white mb-3">Issues</h3>
      <div class="bg-white rounded-lg min-h-[50vh] sm:min-h-[28rem] px-4 py-2">
        <canvas id="all-issues-stacked-graph"></canvas>
      </div>
    </div>
    <div>
      <h3 class="heading-4 text-white mb-3">Pull requests</h3>
      <div class="bg-white rounded-lg min-h-[50vh] sm:min-h-[28rem] px-4 py-2">
        <canvas id="all-prs-stacked-graph"></canvas>
      </div>
    </div>
  </div>

  <h2 class="heading-3 text-white mt-12">
    Today <abbr
      class="text-gray-300 heading-5 ml-[-5px] align-top"
      title="Only repositories that have on average more than 7 issues in the last 14 days are included in the charts below."
      >(?)</abbr
    >
  </h2>
  <section class="flex flex-col sm:flex-row gap-8">
    <div class="flex-1 flex flex-col">
      <h2 class="heading-4 text-white my-6">Issues per repo</h2>
      <div class="bg-white rounded-lg p-4">
        <canvas id="issues-repos-pie-chart"></canvas>
      </div>
      <h2 class="heading-4 text-white my-6">Pull requests per repo</h2>
      <div class="bg-white rounded-lg p-4">
        <canvas id="prs-repos-pie-chart"></canvas>
      </div>
    </div>
    <div class="flex-grow">
      <LabelStats />
    </div>
  </section>

  <h2 class="heading-3 text-white mt-12 mb-6">Fun stats</h2>
  <div class="w-full flex flex-wrap *:flex-grow *:basis-80 gap-8">
    {
      funStats.map((stat) => (
        <div class="bg-white rounded-lg p-4">
          <h3 class="heading-4 text-black" set:html={stat.prompt} />
          <p class="text-gray-900 font-bold text-2xl my-2">{stat.repo}</p>
          <p class="text-gray-500">{stat.comment}</p>
        </div>
      ))
    }
  </div>

  <script>
    import Chart from "chart.js/auto";
    import {
      allReposIssueData,
      allReposPRData,
      sortLegend,
      sortTooltips,
      todayData,
    } from "../scripts/data";

    const allIssuesCTX = document.getElementById("all-issues-stacked-graph") as HTMLCanvasElement;
    const allPRsCTX = document.getElementById("all-prs-stacked-graph") as HTMLCanvasElement;

    const issuesPerRepoPieChartCTX = document.getElementById("issues-repos-pie-chart") as HTMLCanvasElement;
    const prsPerRepoPieChartCTX = document.getElementById("prs-repos-pie-chart") as HTMLCanvasElement;

    if (!allIssuesCTX || !issuesPerRepoPieChartCTX || !allPRsCTX || !prsPerRepoPieChartCTX) {
      throw new Error("Could not find canvas element");
    }

    const timelineChartConfig = ({ title, yAxisLabel, data }: { title: string; yAxisLabel: string; data: any }) => ({
      type: "line",
      data: data,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: {
            display: true,
            text: title,
          },
          legend: {
            position: "top",
            labels: {
              sort: sortLegend,
            },
          },
          tooltip: {
            mode: "index",
            itemSort: sortTooltips,
            callbacks: {
              footer(tooltipItems) {
                // Show total issues count in the tooltip
                const total = tooltipItems.reduce(
                  (acc, item) => acc + item.parsed.y,
                  0,
                );
                return `Total: ${total}`;
              },
            },
          },
        },
        interaction: {
          mode: "nearest",
          axis: "x",
          intersect: false,
        },
        scales: {
          x: {
            title: {
              display: true,
              text: "Last 30 days",
            },
          },
          y: {
            beginAtZero: true,
            stacked: true,
            title: {
              display: true,
              text: yAxisLabel,
            },
          },
        },
      },
    })

    new Chart(allIssuesCTX, timelineChartConfig({
      title: "Total open issues on all Astro repos",
      yAxisLabel: "Issue count",
      data: allReposIssueData
    }));
    new Chart(allPRsCTX, timelineChartConfig({
      title: "Total open PRs on all Astro repos",
      yAxisLabel: "PR count",
      data: allReposPRData
    }));

    const pieChartConfig = ({ data }: { data: any }) => ({
      type: "pie",
      data,
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: "bottom",
            labels: {
              sort: sortLegend,
            },
          },
          tooltip: {
            mode: "index",
            itemSort: sortTooltips,
            callbacks: {
              label: function (context) {
                var label = context.label,
                  currentValue = context.raw as number,
                  total = (context.chart as any)._metasets[context.datasetIndex]
                    .total;

                context.chart.data.datasets;

                var percentage = parseFloat(
                  ((currentValue / total) * 100).toFixed(1),
                );

                return label + ": " + currentValue + " (" + percentage + "%)";
              },
            },
          },
        },
      },
    });

    new Chart(issuesPerRepoPieChartCTX, pieChartConfig({ data: todayData.issues }));
    new Chart(prsPerRepoPieChartCTX, pieChartConfig({ data: todayData.prs }));
  </script>
</Layout>
